# ===== PRODUCTION .env namunasi (EC2, domensiz, port 8000) =====
# Serverda /opt/app/.env sifatida joylashtiring. Real qiymatlarni to'ldiring.

# Umumiy
APP_ENV=production
APP_NAME=Universal AI Backend
# Domen yo'q — EC2 public DNS/IP ishlatiladi
BASE_DOMAIN=localhost
API_URL=http://<EC2_PUBLIC_DNS>:8000
ALLOWED_FRONTEND_SUFFIX=.localhost
# Frontend to'liq origin(lar)ini shu yerga yozing (vergul bilan), masalan:
# EXTRA_CORS_ORIGINS=http://<EC2_PUBLIC_DNS>:3000,https://myfrontend.vercel.app
EXTRA_CORS_ORIGINS=

# Baza (prod'da kuchli parol!)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://app:CHANGE_ME_STRONG_PASSWORD@db:5432/app

# Email (Gmail SMTP — App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Google OAuth (ixtiyoriy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# JWT (prod'da albatta yangi random qiymatlar!)
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=240
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_SECRET=CHANGE_ME_RANDOM_64_CHARS
ADMIN_EMAILS=
# Prod'da demo login o'chirilsin
DEMO_LOGIN_ENABLED=false

# LLM (Groq — OpenAI-compatible)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_API_KEYS=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b

# Gemini
GEMINI_API_KEY=
GEMINI_API_KEYS=

# Embedding
EMBEDDING_DIM=3072

# Fayllar
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20
