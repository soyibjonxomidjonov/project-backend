# Umumiy
APP_ENV=development
APP_NAME=Universal AI Backend
BASE_DOMAIN=localhost
API_URL=http://localhost:8000
ALLOWED_FRONTEND_SUFFIX=.localhost
EXTRA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Baza
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app

# Email (Gmail SMTP — App Password kerak)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Google OAuth (ixtiyoriy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.<DOMAIN>/auth/google/callback

# JWT
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=240
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_SECRET=
ADMIN_EMAILS=
DEMO_LOGIN_ENABLED=true

# LLM (Groq — OpenAI-compatible API)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_API_KEYS=
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# Gemini (rasm tahlili + embedding)
GEMINI_API_KEY=
GEMINI_API_KEYS=

# Embedding (Gemini text-embedding-004)
EMBEDDING_DIM=768

# Fayllar
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20
